<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Unity3DCompressor</AssemblyName>
    <RootNamespace>Unity3DCompressor</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <Version>1.2</Version>
  </PropertyGroup>

  <!-- The DLL pinned in lib/ is AssetsTools.NET 2.0.0 (2020), which only understands bundle
       format versions 3/6/7. 3.x is required for UnityFS v8 bundles (Unity 6+). -->
  <ItemGroup>
    <PackageReference Include="AssetsTools.NET" Version="3.0.5" />
  </ItemGroup>

</Project>
